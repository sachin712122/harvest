<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths used for sharing camera-captured images with the WebView.
  The 'cache-path' entry covers the temp files created by the camera intent.
-->
<paths>
    <cache-path name="camera_images" path="images/" />
    <external-files-path name="external_images" path="Pictures/" />
</paths>
